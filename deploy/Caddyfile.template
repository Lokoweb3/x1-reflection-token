# Public HTTPS for the 99 + Tax site. Caddy gets and renews the certificate itself.
# Only the launch site is public; the private dashboard stays on 127.0.0.1:8123.
__DOMAIN__ {
	encode gzip
	reverse_proxy 127.0.0.1:8124
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
