[Unit]
Description=RFLT distributor (collect tax, burn, sell, auto-LP, creator reward, pay holders)
After=network-online.target
Wants=network-online.target

[Service]
User=reflect
WorkingDirectory=/opt/x1-reflection-token
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs src/distribute.ts --execute --loop 30
Restart=always
RestartSec=15
# Hardening: only state/ and factory/ are writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/x1-reflection-token/state /opt/x1-reflection-token/factory

[Install]
WantedBy=multi-user.target
